{
    "name": "aviflow",
    "version": "2.0.1",
    "description": "A lightweight, dependency-free JavaScript utility to automate event-driven HTML flow, using data-flow attributes",
    "author": "Aviato Soft",
    "license": "Apache 2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/aviato-soft/aviflow"
    },
    "type": "module",
    "main": "dist/aviflow.cjs.js",
    "module": "dist/aviflow.esm.js",
    "unpkg": "dist/aviflow.min.js",
    "scripts": {
        "build": "node build.mjs",
        "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "www": "npx http-server --port 8080"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2"
    },
    "overrides": {
        "argparse": "^3.0.3",
        "js-yaml": "^4.1.0",
        "sprintf-js": "^1.1.3"    
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
